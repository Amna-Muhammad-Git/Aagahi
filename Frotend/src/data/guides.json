  "guides": [
    {
      "id": "whatsapp-video-call",
      "app": "whatsapp",
      "title": "Make a WhatsApp video call",
      "title_ur": "واٹس ایپ ویڈیو کال",
      "steps": [
        {
          "text": "Open WhatsApp and tap the name of the person you want to call.",
          "screen": "wa-list",
          "hl": "Ayesha"
        },
        {
          "text": "Their chat opens. Look at the top right corner to find the video camera icon.",
          "screen": "wa-chat",
          "hl": "video"
        },
        {
          "text": "Tap the video camera icon. If WhatsApp asks to use your camera and microphone, allow it only if you want to make the call.",
          "screen": "wa-chat",
          "hl": "video"
        },
        {
          "text": "Wait while it rings. The call starts when the other person answers.",
          "screen": "wa-calling"
        },
        {
          "text": "When you are finished, tap the red button to end the call.",
          "screen": "wa-calling",
          "hl": "end"
        }
      ]
    },
    {
      "id": "whatsapp-voice-message",
      "app": "whatsapp",
      "title": "Send a voice message",
      "title_ur": "وائس میسج بھیجیں",
      "steps": [
        {
          "text": "Open the chat with the person you want to talk to.",
          "screen": "wa-list",
          "hl": "Ayesha"
        },
        {
          "text": "Find the microphone icon on the right of the message box.",
          "screen": "wa-chat",
          "hl": "mic"
        },
        {
          "text": "Press and hold the microphone, then start speaking. Keep your finger on the screen.",
          "screen": "wa-recording",
          "hl": "mic"
        },
        {
          "text": "Lift your finger when you are done and the message sends. To cancel instead, slide your finger to the left before letting go.",
          "screen": "wa-recording",
          "hl": "mic"
        },
        {
          "text": "Check that your voice message appears in the chat. Tap it to listen back.",
          "screen": "wa-sent-voice"
        }
      ]
    },
    {
      "id": "whatsapp-share-location",
      "app": "whatsapp",
      "title": "Share your location",
      "title_ur": "لوکیشن شیئر کریں",
      "steps": [
        {
          "text": "Open the chat with the person you want to share with.",
          "screen": "wa-list",
          "hl": "Ayesha"
        },
        {
          "text": "Tap the plus (+) or paperclip button next to the message box.",
          "screen": "wa-chat",
          "hl": "plus"
        },
        {
          "text": "Choose Location from the menu.",
          "screen": "wa-attach",
          "hl": "Location"
        },
        {
          "text": "WhatsApp may ask permission to use your location. Allow it only if you want to share.",
          "screen": "wa-location"
        },
        {
          "text": "Choose Send your current location for a one-time share, or Share live location to update while you move.",
          "screen": "wa-location",
          "hl": "Send your current location"
        },
        {
          "text": "Check the name at the top, then confirm. Only share your location with people you know.",
          "screen": "wa-chat"
        }
      ]
    },
    {
      "id": "whatsapp-send-photo",
      "app": "whatsapp",
      "title": "Send a photo or file",
      "title_ur": "تصویر یا فائل بھیجیں",
      "steps": [
        {
          "text": "Open the chat with the person you want to send to.",
          "screen": "wa-list",
          "hl": "Ayesha"
        },
        {
          "text": "Tap the plus (+) or paperclip button next to the message box.",
          "screen": "wa-chat",
          "hl": "plus"
        },
        {
          "text": "Choose Gallery for a photo, or Document for a file.",
          "screen": "wa-attach",
          "hl": "Gallery"
        },
        {
          "text": "Tap the photo or file you want to send.",
          "screen": "wa-gallery",
          "hl": "Photo 1"
        },
        {
          "text": "Check the picture and the name at the top. That person will receive it.",
          "screen": "wa-gallery"
        },
        {
          "text": "Tap the send arrow.",
          "screen": "wa-gallery",
          "hl": "send"
        }
      ]
    },
    {
      "id": "gmail-attach-file",
      "app": "gmail",
      "title": "Attach a file in Gmail",
      "title_ur": "جی میل میں فائل لگائیں",
      "steps": [
        {
          "text": "Open Gmail and tap Compose to start a new email.",
          "screen": "gm-inbox",
          "hl": "compose"
        },
        {
          "text": "Type the person's email address and a subject.",
          "screen": "gm-compose"
        },
        {
          "text": "Tap the paperclip icon at the top.",
          "screen": "gm-compose",
          "hl": "paperclip"
        },
        {
          "text": "Choose Attach file, then pick the file from your phone.",
          "screen": "gm-attach-menu",
          "hl": "Attach file"
        },
        {
          "text": "Check that the file name appears in your email.",
          "screen": "gm-attached",
          "hl": "Attached: bill.pdf"
        },
        {
          "text": "Tap the send arrow when you are ready.",
          "screen": "gm-attached",
          "hl": "send"
        }
      ]
    }
